{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "links": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('hostKey').exists() && root.child('hostAuth/'+auth.uid).val() === root.child('hostKey').val()"
    },
    "photos": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('hostKey').exists() && root.child('hostAuth/'+auth.uid).val() === root.child('hostKey').val()",
        ".validate": "newData.child('img').isString() && newData.child('img').val().length < 400000"
      }
    },
    "hostAuth": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length < 100"
      }
    },
    "hostCheck": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('hostKey').exists() && root.child('hostAuth/'+auth.uid).val() === root.child('hostKey').val()"
      }
    },
    "stats": {
      ".read": "auth != null && root.child('hostKey').exists() && root.child('hostAuth/'+auth.uid).val() === root.child('hostKey').val()",
      "d": {
        "$day": {
          "$vid": {
            ".write": "auth != null && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && $vid.matches(/^[a-z0-9]{12}$/) && newData.exists()",
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
            },
            "sea": {
              ".validate": "newData.isBoolean()"
            },
            "river": {
              ".validate": "newData.isBoolean()"
            },
            "namsan": {
              ".validate": "newData.isBoolean()"
            },
            "space": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
